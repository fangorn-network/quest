{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "westmarch build",
    "deploy": "wrangler deploy",
    "build:data": "pipeline/fetch.sh && .venv/bin/python pipeline/build_bundle.py",
    "build:web": "pipeline/web.sh",
    "view": "npm run build:web && echo 'quest at http://127.0.0.1:8787/' && python3 -m http.server 8787 --bind 127.0.0.1 --directory web",
    "publish:data": "pipeline/publish-data.sh",
    "build:record": "node pipeline/region_record.mjs"
  },
  "dependencies": {
    "@fangorn-network/westmarch": "2026.10.26-dev",
    "@huggingface/transformers": "^4.3.1",
    "wrangler": "^4.83.0",
    "@fangorn-network/sdk": "2026.10.26-dev"
  },
  "name": "quest",
  "overrides": {
    "@fangorn-network/sdk": "$@fangorn-network/sdk"
  }
}
