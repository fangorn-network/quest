{
 "name": "quest",
 "main": "node_modules/@fangorn-network/westmarch/site/worker.js",
 "compatibility_date": "2025-09-15",
 "compatibility_flags": [
  "nodejs_compat"
 ],
 "assets": {
  "directory": ".ship/site",
  "binding": "ASSETS",
  "run_worker_first": [
   "/.well-known/agent-card.json",
   "/openapi.json",
   "/.well-known/x402"
  ]
 },
 "r2_buckets": [
  {
   "binding": "VIEW",
   "bucket_name": "quest-view",
   "preview_bucket_name": "quest-view"
  }
 ],
 "ai": {
  "binding": "AI"
 },
 "triggers": {
  "crons": [
   "*/5 * * * *"
  ]
 },
 "alias": {
  "@huggingface/transformers": "./node_modules/@fangorn-network/westmarch/site/no-model.js"
 },
 "vars": {
  "CONFIG": {
   "app": "quest",
   "name": "quest",
   "description": "Printable driving directions for Mississippi, found and routed in your browser from OpenStreetMap and US Census data: the addresses you type never leave your device.",
   "fromBlock": "48884613",
   "network": "baseSepolia",
   "schema": {
    "types": {
     "quest.region.v1": {
      "description": "One region's map data for private, on-device directions: a bundle of roads and addresses, its size, its sha256 and where to download it.",
      "role_map": {
       "identity": "id",
       "title": "title",
       "tags": [
        "tags"
       ],
       "text": [
        "text"
       ]
      },
      "presentation": {
       "types": {
        "quest.region.v1": {
         "singular": "region",
         "plural": "regions"
        }
       },
       "facets": [
        "tags"
       ]
      }
     }
    },
    "relations": []
   },
   "repos": [],
   "paid": null,
   "private": null
  }
 },
 "account_id": "0beaeb0776ca9e8404297afe0da73e5a"
}
